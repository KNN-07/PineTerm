# Required: choose a unique admin password. Generate session material with openssl rand -base64 48.
PINETERM_ADMIN_PASSWORD=
PINETERM_SESSION_SECRET=
# Required AES-256-GCM key: openssl rand -base64 32
PINETERM_SECRET_KEY=
PINETERM_DATA_DIR=./data
PINETERM_HOST=127.0.0.1
PINETERM_PORT=3000
# Production default; dev defaults to http://127.0.0.1:5173 when omitted.
# PINETERM_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional exact development-only webhook hosts, e.g. 127.0.0.1 for a local receiver.
# Production refuses private-address exceptions; never use wildcards.
# PINETERM_DEV_WEBHOOK_HOSTS=
